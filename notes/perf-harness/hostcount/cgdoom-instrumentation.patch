diff -ruN --strip-trailing-cr orig/src-sdl2/bench.c cgd/src-sdl2/bench.c
--- orig/src-sdl2/bench.c	1970-01-01 01:00:00
+++ cgd/src-sdl2/bench.c	2026-10-09 22:38:24
@@ -0,0 +1,59 @@
+#include "bench.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+bench_t bench;
+#define MAXF 20000
+typedef struct { uint64_t v[24]; } snap_t;
+static snap_t prev; static int nf = 0;
+static const char *names[] = {"fm_render","fd_render","sd_render","fm_game","fd_game","sd_game",
+ "col_px","span_px","fuzz_px","trans_px","col_calls","span_calls","mapplane","mapplane_rowmiss",
+ "storewall","segloop_cols","iscale_div","pointonside","pointtoangle","getcolumn","cachelump","visplanes","vissprites","spr_dsscan"};
+static uint32_t *series[24];
+static void take(snap_t *s){ uint64_t *v=s->v; v[0]=bench.fm[1]; v[1]=bench.fd[1]; v[2]=bench.sd[1]; v[3]=bench.fm[0]; v[4]=bench.fd[0]; v[5]=bench.sd[0];
+ v[6]=bench.col_px; v[7]=bench.span_px; v[8]=bench.fuzz_px; v[9]=bench.trans_px; v[10]=bench.col_calls; v[11]=bench.span_calls; v[12]=bench.mapplane_calls; v[13]=bench.mapplane_rowmiss;
+ v[14]=bench.storewall; v[15]=bench.segloop_cols; v[16]=bench.iscale_div; v[17]=bench.pointonside; v[18]=bench.pointtoangle; v[19]=bench.getcolumn; v[20]=bench.cachelump; v[21]=bench.visplanes; v[22]=bench.vissprites; v[23]=bench.spr_dsscan; }
+static int cmp(const void *a, const void *b){ uint32_t x=*(const uint32_t*)a, y=*(const uint32_t*)b; return x<y?-1:x>y; }
+void bench_frame(void){
+  static int limit = -1; if(limit<0){ const char *e=getenv("BENCH_FRAMES"); limit = e?atoi(e):3000; if(limit>MAXF) limit=MAXF; for(int i=0;i<24;i++) series[i]=calloc(MAXF,4); take(&prev); }
+  snap_t now; take(&now);
+  for(int i=0;i<24;i++) series[i][nf] = (uint32_t)(now.v[i]-prev.v[i]);
+  prev = now; nf++;
+  if(nf >= limit){
+    printf("BENCH frames=%d tics=%llu\n", nf, (unsigned long long)bench.tics);
+    printf("%-18s %10s %10s %10s %10s\n","metric","mean/frame","p50","p95","max");
+    for(int i=0;i<24;i++){ uint64_t sum=0; for(int f=0;f<nf;f++) sum+=series[i][f];
+      uint32_t *c=malloc(nf*4); memcpy(c,series[i],nf*4); qsort(c,nf,4,cmp);
+      printf("%-18s %10.1f %10u %10u %10u\n", names[i], (double)sum/nf, c[nf/2], c[(nf*95)/100], c[nf-1]); free(c); }
+    exit(0);
+  }
+}
+#include "doomdef.h"
+#include "doomstat.h"
+#include "d_ticcmd.h"
+#include "d_event.h"
+#include "g_game.h"
+static uint32_t bseed = 7;
+static uint32_t brnd(void){ bseed ^= bseed << 13; bseed ^= bseed >> 17; bseed ^= bseed << 5; return bseed; }
+#include "p_local.h"
+void bench_ticcmd(ticcmd_t *cmd){
+  static int t = 0, turn = 0, map = 1, unstick = 0; static fixed_t lx, ly; t++;
+  const char *e = getenv("BENCH_MAPTICS"); int maptics = e ? atoi(e) : 1050;
+  cmd->forwardmove = 0x32; cmd->buttons = 0; cmd->angleturn = 0;
+  if(gamestate == GS_LEVEL && players[consoleplayer].mo) {
+    mobj_t *mo = players[consoleplayer].mo;
+    players[consoleplayer].cheats |= CF_GODMODE;
+    if(t % 8 == 0) {
+      fixed_t d = abs(mo->x - lx) + abs(mo->y - ly);
+      if(d < 24*FRACUNIT && !unstick) { unstick = 12 + (int)(brnd() % 16); turn = (brnd() & 1) ? 2400 : -2400; }
+      lx = mo->x; ly = mo->y;
+    }
+    /* look ahead: probe a point 96 units in front; if it is inside a solid area, start turning early */
+    if(!unstick && t % 35 == 0) turn = (int)(brnd() % 600) - 300;
+  }
+  if(unstick) { unstick--; cmd->forwardmove = (unstick > 6) ? -0x19 : 0x19; if(!unstick) turn = 0; }
+  cmd->angleturn = (short)turn;
+  if(t % 20 == 0) cmd->buttons |= BT_USE;
+  if((t / 35) % 3 == 0 && (t % 4) == 0) cmd->buttons |= BT_ATTACK;
+  if(t % maptics == 0) { map = map % 8 + 1; G_DeferedInitNew(sk_medium, 1, map); }
+}
