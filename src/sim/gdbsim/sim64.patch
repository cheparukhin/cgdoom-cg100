+/* ---- CGDoom sim64 extension ----------------------------------------------------------------------
+   * all statistics are 64-bit (sim_resume keeps them in locals; saved_state.asregs.*64 hold the totals);
+   * extra "trapa #34" services for the program (unknown numbers still return -1 on a stock simulator):
+       0x7f00  r5 = ptr to 8 big-endian words: insts(hi,lo) cycles(hi,lo) stalls(hi,lo) memstalls(hi,lo)
+       0x7f01  r5 = 0/1: pause/resume the PC profile
+       0x7f02  r5 = id: print "SIMMARK <id> <insts> <cycles>" on stderr
+   * per-PC profile: set SIM_PCPROF=<file>; on exit the file lists "<hexpc> <insts> <cycles>" for every
+     executed instruction address below 8 MiB (cycles = the simulator's cycle model, branch penalties
+     included, a delay slot is charged to its branch). */
+
+#define PCPROF_N (4u << 20)   /* halfword slots: addresses 0 .. 8 MiB */
+static unsigned int *pcprof_n, *pcprof_c;
+static const char *pcprof_file;
+static int pcprof_on;
+static unsigned long long live_insts, live_cycles, live_stalls, live_memstalls;
+
+#define SIM64_LIVE(c, i, s, m) \
+  (live_cycles = (c), live_insts = (i), live_stalls = (s), live_memstalls = (m), 0)
+
+static void
+pcprof_dump (void)
+{
+  FILE *f;
+  unsigned int k;
+
+  if (!pcprof_file || !pcprof_n)
+    return;
+  f = fopen (pcprof_file, "w");
+  if (!f)
+    {
+      fprintf (stderr, "sim: cannot write %s\n", pcprof_file);
+      return;
+    }
+  for (k = 0; k < PCPROF_N; k++)
+    if (pcprof_n[k])
+      fprintf (f, "%x %u %u\n", k * 2, pcprof_n[k], pcprof_c[k]);
+  fclose (f);
+}
+
+static void
+pcprof_init (void)
+{
+  static int done;
+
+  if (done)
+    return;
+  done = 1;
+  if (getenv ("SIM_NULLTRAP") && !strcmp (getenv ("SIM_NULLTRAP"), "0"))
+    null_limit = 0;
+  pcprof_file = getenv ("SIM_PCPROF");
+  if (!pcprof_file || !*pcprof_file)
+    {
+      pcprof_file = 0;
+      return;
+    }
+  pcprof_n = (unsigned int *) calloc (PCPROF_N, sizeof (unsigned int));
+  pcprof_c = (unsigned int *) calloc (PCPROF_N, sizeof (unsigned int));
+  if (!pcprof_n || !pcprof_c)
+    {
+      fprintf (stderr, "sim: out of memory for SIM_PCPROF\n");
+      pcprof_file = 0;
+      return;
+    }
+  pcprof_on = 1;
+  atexit (pcprof_dump);
+}
